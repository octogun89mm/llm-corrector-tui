#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

active_json="$(hyprctl activewindow -j 2>/dev/null || true)"
target_address="$(
  ACTIVE_JSON="$active_json" python3 -c 'import json, os
try:
    print(json.loads(os.environ.get("ACTIVE_JSON", "{}")).get("address", ""))
except Exception:
    print("")
' 2>/dev/null
)"

export LLM_CORRECTOR_TARGET_ADDRESS="$target_address"

exec ghostty \
  --class=llm-corrector \
  --title=llm-corrector \
  --window-decoration=false \
  --gtk-titlebar=false \
  --background-opacity=0.96 \
  --window-padding-x=18 \
  --window-padding-y=16 \
  --window-width=76 \
  --window-height=14 \
  "--keybind=shift+enter=csi:13;2u" \
  -e "$root/bin/llm-corrector"
